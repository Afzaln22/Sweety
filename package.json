{
  "name": "sweety-app",
  "version": "1.0.0",
  "description": "Sweety - Blood Glucose Tracker (Decoupled Frontend & Backend)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test",
    "build:frontend": "npm --prefix frontend run build",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "clean:data": "npm --prefix backend run clean:data"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
